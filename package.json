{
  "name": "keltra-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for keltra: The smart autocomplete for your web assets.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "build:watch": "turbo run build:watch",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "biome:migrate": "bunx biome migrate --write",
    "cli": "bun run packages/keltra/src/cli/index.ts",
    "clean": "turbo run clean && rm -rf .turbo node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.2",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=20.9.0"
  }
}
