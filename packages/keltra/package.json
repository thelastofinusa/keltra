{
  "name": "keltra",
  "version": "0.1.16",
  "description": "The smart autocomplete for your web assets.",
  "keywords": [
    "assets",
    "typescript",
    "typed-paths",
    "vite",
    "nextjs",
    "image",
    "codegen"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "keltra": "./dist/cli/index.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thelastofinusa/keltra.git",
    "directory": "packages/keltra"
  },
  "homepage": "https://usekeltra.vercel.app",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/integrations/vite.d.mts",
      "default": "./dist/integrations/vite.mjs"
    },
    "./next": {
      "types": "./dist/integrations/next.d.mts",
      "default": "./dist/integrations/next.mjs"
    },
    "./image": {
      "types": "./dist/image/index.d.mts",
      "default": "./dist/image/index.mjs"
    },
    "./image/next": {
      "types": "./dist/image/next.d.mts",
      "default": "./dist/image/next.mjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "vite": [
        "./dist/integrations/vite.d.mts"
      ],
      "next": [
        "./dist/integrations/next.d.mts"
      ],
      "webpack": [
        "./dist/integrations/webpack.d.mts"
      ],
      "nuxt": [
        "./dist/integrations/nuxt.d.mts"
      ],
      "astro": [
        "./dist/integrations/astro.d.mts"
      ],
      "sveltekit": [
        "./dist/integrations/sveltekit.d.mts"
      ],
      "image": [
        "./dist/image/index.d.mts"
      ],
      "image/next": [
        "./dist/image/next.d.mts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "bun run ./src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "cp ../../README.md ./README.md",
    "lint": "biome check .",
    "clean": "rm -rf .turbo dist node_modules"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2",
    "astro": ">=4",
    "next": "^16.4.5",
    "nuxt": ">=3",
    "react": "^19.3.1",
    "vite": "workspace:*",
    "webpack": ">=5"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.4"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@plekta/utils": "^0.0.4",
    "chalk": "^6.0.1",
    "chokidar": "^6.0.0",
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "jsonc-parser": "^3.3.1",
    "tinyglobby": "^0.2.17"
  }
}
